{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|preset-thumbnails/|landing-custom/|favicon.svg|icons.svg|logo-mark.svg|logo-mark.png|icon-192.png|icon-512.png|manifest.webmanifest|sw.js|special.html|sales-im.css|colors_and_type.css|preset-names.json|preset-gallery.json).*)",
      "destination": "/index.html"
    }
  ]
}
